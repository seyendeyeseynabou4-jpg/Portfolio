/* ================================================
   PORTFOLIO - SEYNABOU | style.css
   ================================================ */

/* ======== 1. VARIABLES & RESET ======== */
:root {
  --primary:       #ff6b81;
  --primary-light: #ffb3c1;
  --primary-dark:  #e0566d;
  --secondary:     #d0bdf4;
  --accent:        #ffe4e1;
  --dark-bg:       #fff5f7;
  --dark-card:     #ffffff;
  --dark-border:   rgba(255, 107, 129, 0.18);
  --text-primary:  #2d3436;
  --text-muted:    #636e72;
  --glass-bg:      rgba(255, 255, 255, 0.65);
  --glass-border:  rgba(255, 107, 129, 0.25);

  --gradient-main: linear-gradient(135deg, #ff6b81 0%, #ffb3c1 50%, #d0bdf4 100%);
  --gradient-dark: linear-gradient(135deg, #fff5f7 0%, #ffffff 100%);
  --gradient-card: linear-gradient(160deg, rgba(255, 107, 129,0.12) 0%, rgba(208, 189, 244,0.06) 100%);

  --shadow-glow:   0 0 30px rgba(255, 107, 129, 0.35);
  --shadow-card:   0 8px 32px rgba(0, 0, 0, 0.45);
  --shadow-hover:  0 16px 48px rgba(255, 107, 129, 0.4);

  --radius-sm: 8px;
  --radius-md: 16px;
  --radius-lg: 24px;
  --radius-xl: 32px;

  --transition: 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  --font-main: 'Inter', sans-serif;
  --font-code: 'Fira Code', monospace;
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

html { scroll-behavior: smooth; font-size: 16px; }

body {
  font-family: var(--font-main);
  background-color: var(--dark-bg);
  color: var(--text-primary);
  overflow-x: hidden;
  line-height: 1.7;
  position: relative; /* Requis pour Bootstrap ScrollSpy */
}

img { max-width: 100%; height: auto; }
a { text-decoration: none; }
ul { list-style: none; }

/* ======== 2. UTILITAIRES ======== */
.gradient-text {
  background: var(--gradient-main);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.glass-card {
  background: var(--glass-bg);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-lg);
  padding: 2rem;
  box-shadow: var(--shadow-card);
}

.section-padding { padding: 100px 0; }

.section-dark { background: var(--dark-card); }

.section-header { margin-bottom: 3rem; }

.section-tag {
  display: inline-block;
  font-family: var(--font-code);
  font-size: 0.8rem;
  color: var(--primary-light);
  background: rgba(255, 107, 129, 0.12);
  border: 1px solid rgba(255, 107, 129, 0.3);
  border-radius: 100px;
  padding: 4px 16px;
  letter-spacing: 0.05em;
  margin-bottom: 1rem;
}

.section-title {
  font-size: clamp(2rem, 5vw, 3rem);
  font-weight: 800;
  line-height: 1.15;
}

/* ======== 3. NAVBAR ======== */
#mainNav {
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-bottom: 1px solid var(--dark-border);
  padding: 0.8rem 0;
  box-shadow: var(--shadow-glow);
  transition: padding 0.3s ease;
}

.navbar-brand {
  font-family: var(--font-code);
  font-size: 1.35rem;
  font-weight: 700;
  color: var(--text-primary) !important;
  letter-spacing: -0.02em;
}
.brand-bracket { color: var(--primary); }

.nav-link {
  color: var(--text-muted) !important;
  font-weight: 500;
  font-size: 0.9rem;
  padding: 0.4rem 0.8rem !important;
  border-radius: var(--radius-sm);
  transition: all var(--transition);
  position: relative;
}
.nav-link::after {
  content: '';
  position: absolute;
  bottom: 0; left: 50%;
  transform: translateX(-50%);
  width: 0; height: 2px;
  background: var(--gradient-main);
  border-radius: 2px;
  transition: width var(--transition);
}
.nav-link:hover, .nav-link.active {
  color: var(--text-primary) !important;
}
.nav-link:hover::after, .nav-link.active::after { width: 60%; }

/* Hamburger custom */
.navbar-toggler {
  border: none;
  background: transparent !important;
  cursor: pointer;
  display: flex;
  flex-direction: column;
  gap: 5px;
  padding: 0.4rem;
}
.toggler-icon {
  display: block;
  width: 25px; height: 2px;
  background: var(--primary-light);
  border-radius: 2px;
  transition: all 0.3s ease;
}
.navbar-toggler:focus { box-shadow: none; }

/* ======== 4. HERO ======== */
.hero-section {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
  background: var(--gradient-dark);
  padding-top: 90px;
}

/* Blobs décoratifs */
.hero-blob {
  position: absolute;
  border-radius: 50%;
  filter: blur(80px);
  opacity: 0.18;
  animation: blobFloat 8s ease-in-out infinite;
  pointer-events: none;
}
.hero-blob--1 {
  width: 500px; height: 500px;
  background: var(--primary);
  top: -150px; left: -150px;
  animation-delay: 0s;
}
.hero-blob--2 {
  width: 350px; height: 350px;
  background: var(--secondary);
  bottom: -100px; right: -80px;
  animation-delay: -3s;
}
.hero-blob--3 {
  width: 250px; height: 250px;
  background: var(--accent);
  top: 40%; left: 55%;
  animation-delay: -6s;
}

@keyframes blobFloat {
  0%, 100% { transform: scale(1) translate(0, 0); }
  33%       { transform: scale(1.05) translate(15px, -20px); }
  66%       { transform: scale(0.97) translate(-10px, 15px); }
}

.hero-greeting {
  font-size: 1rem;
  color: var(--primary-light);
  font-weight: 500;
  margin-bottom: 0.5rem;
  letter-spacing: 0.02em;
}
.hero-name {
  font-size: clamp(3rem, 8vw, 5.5rem);
  font-weight: 900;
  line-height: 1;
  background: var(--gradient-main);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: 0.75rem;
}
.hero-tagline {
  font-size: clamp(1rem, 2.5vw, 1.3rem);
  font-weight: 500;
  color: var(--text-muted);
  min-height: 3.5rem;
  margin-bottom: 1rem;
}
.typing-wrapper { display: none; }
.typing-cursor  { display: none; }
@keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }

.hero-desc {
  color: var(--text-muted);
  font-size: 1rem;
  max-width: 480px;
}

/* Boutons hero */
.btn-primary-custom {
  display: inline-flex;
  align-items: center;
  background: var(--gradient-main);
  color: #fff !important;
  font-weight: 600;
  font-size: 0.95rem;
  padding: 0.7rem 1.75rem;
  border-radius: 100px;
  border: none;
  box-shadow: 0 4px 24px rgba(255, 107, 129, 0.45);
  transition: all var(--transition);
  cursor: pointer;
}
.btn-primary-custom:hover {
  transform: translateY(-3px);
  box-shadow: 0 8px 32px rgba(255, 107, 129, 0.6);
}

.btn-outline-custom {
  display: inline-flex;
  align-items: center;
  background: transparent;
  color: var(--primary-light) !important;
  font-weight: 600;
  font-size: 0.95rem;
  padding: 0.7rem 1.75rem;
  border-radius: 100px;
  border: 1.5px solid var(--primary);
  transition: all var(--transition);
}
.btn-outline-custom:hover {
  background: rgba(255, 107, 129,0.15);
  transform: translateY(-3px);
  box-shadow: 0 4px 24px rgba(255, 107, 129, 0.25);
}

/* Icônes sociales hero */
.social-icon {
  width: 42px; height: 42px;
  display: flex; align-items: center; justify-content: center;
  border-radius: 50%;
  border: 1.5px solid var(--dark-border);
  color: var(--text-muted);
  font-size: 1.1rem;
  transition: all var(--transition);
}
.social-icon:hover {
  color: var(--primary-light);
  border-color: var(--primary);
  background: rgba(255, 107, 129,0.12);
  transform: translateY(-3px);
}

/* Image héro */
.hero-img-wrapper {
  position: relative;
  max-width: 460px;
}
.hero-illustration {
  width: 100%;
  border-radius: var(--radius-xl);
  filter: drop-shadow(0 20px 60px rgba(255, 107, 129, 0.4));
  animation: heroFloat 5s ease-in-out infinite;
}

@keyframes heroFloat {
  0%, 100% { transform: translateY(0px); }
  50%       { transform: translateY(-18px); }
}

/* Badges flottants */
.float-badge {
  position: absolute;
  background: var(--glass-bg);
  backdrop-filter: blur(12px);
  border: 1px solid var(--glass-border);
  border-radius: 100px;
  padding: 8px 16px;
  font-size: 0.78rem;
  font-weight: 600;
  color: var(--text-primary);
  white-space: nowrap;
  box-shadow: var(--shadow-card);
  animation: badgeBounce 3s ease-in-out infinite;
}
.float-badge--code { top: 14%; left: -12%; animation-delay: 0s; }
.float-badge--student { bottom: 18%; right: -10%; animation-delay: -1.5s; }

@keyframes badgeBounce {
  0%, 100% { transform: translateY(0); }
  50%       { transform: translateY(-8px); }
}

/* Scroll indicator */
.scroll-indicator {
  position: absolute;
  bottom: 30px;
  left: 50%;
  transform: translateX(-50%);
  display: flex; align-items: center; justify-content: center;
}
.scroll-indicator span {
  display: block;
  width: 24px; height: 40px;
  border: 2px solid var(--dark-border);
  border-radius: 100px;
  position: relative;
}
.scroll-indicator span::after {
  content: '';
  position: absolute;
  top: 6px; left: 50%;
  transform: translateX(-50%);
  width: 4px; height: 8px;
  background: var(--primary-light);
  border-radius: 2px;
  animation: scrollDown 2s ease-in-out infinite;
}
@keyframes scrollDown {
  0%   { top: 6px; opacity: 1; }
  100% { top: 20px; opacity: 0; }
}

/* ======== 5. À PROPOS ======== */
.about-avatar-wrapper {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1.5rem;
}

.avatar-ring {
  width: 200px; height: 200px;
  border-radius: 50%;
  background: var(--gradient-main);
  padding: 4px;
  box-shadow: var(--shadow-glow);
  animation: rotateRing 8s linear infinite;
}
@keyframes rotateRing {
  0%   { box-shadow: 0 0 0   10px rgba(255, 107, 129,0.2), 0 0 40px rgba(255, 107, 129,0.1); }
  50%  { box-shadow: 0 0 0   10px rgba(208, 189, 244,0.25), 0 0 60px rgba(208, 189, 244,0.15); }
  100% { box-shadow: 0 0 0   10px rgba(255, 107, 129,0.2), 0 0 40px rgba(255, 107, 129,0.1); }
}

.avatar-placeholder {
  width: 100%; height: 100%;
  border-radius: 50%;
  background: var(--dark-card);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4px;
  color: var(--primary-light);
  overflow: hidden;
}
.avatar-placeholder i { font-size: 4rem; }
.avatar-placeholder span { font-size: 1.1rem; font-weight: 700; letter-spacing: 0.05em; }

/* Photo réelle */
.avatar-photo {
  width: 100%; height: 100%;
  object-fit: cover;
  object-position: top center;
  border-radius: 50%;
  display: block;
}

.about-badge {
  background: rgba(255, 107, 129, 0.15);
  border: 1px solid rgba(255, 107, 129, 0.3);
  border-radius: 100px;
  padding: 8px 20px;
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--primary-light);
}

.about-text { color: var(--text-muted); margin-bottom: 1rem; }
.about-text strong { color: var(--text-primary); }

/* Stats rapides */
.stat-box {
  background: rgba(255, 107, 129, 0.08);
  border: 1px solid var(--dark-border);
  border-radius: var(--radius-md);
  padding: 1rem;
  text-align: center;
  transition: all var(--transition);
}
.stat-box:hover {
  border-color: var(--primary);
  background: rgba(255, 107, 129, 0.15);
  transform: translateY(-4px);
}
.stat-number {
  display: block;
  font-size: 2rem;
  font-weight: 900;
  background: var(--gradient-main);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  line-height: 1;
  margin-bottom: 4px;
}
.stat-label { font-size: 0.75rem; color: var(--text-muted); font-weight: 500; }

/* ======== 6. COMPÉTENCES ======== */
.skills-subtitle {
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--primary-light);
  margin-bottom: 1.5rem;
}

.skill-item { margin-bottom: 1.4rem; }
.skill-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8px;
}
.skill-name { font-size: 0.9rem; font-weight: 600; color: var(--text-primary); }
.skill-percent { font-size: 0.8rem; font-weight: 700; color: var(--primary-light); font-family: var(--font-code); }

.skill-bar {
  width: 100%; height: 8px;
  background: rgba(0, 0, 0, 0.05);
  border-radius: 100px;
  overflow: hidden;
}
/* Barres animées en CSS pur – valeur via propriété CSS personnalisée */
.skill-fill[data-width="55"] { --bar-w: 55%; }
.skill-fill[data-width="60"] { --bar-w: 60%; }
.skill-fill[data-width="65"] { --bar-w: 65%; }
.skill-fill[data-width="70"] { --bar-w: 70%; }
.skill-fill[data-width="75"] { --bar-w: 75%; }
.skill-fill[data-width="80"] { --bar-w: 80%; }

.skill-fill {
  height: 100%;
  width: var(--bar-w, 0%);
  background: var(--gradient-main);
  border-radius: 100px;
  box-shadow: 0 0 10px rgba(255, 107, 129,0.5);
  animation: growBar 1.4s 0.6s cubic-bezier(0.4,0,0.2,1) both;
}
@keyframes growBar {
  from { width: 0; }
  to   { width: var(--bar-w, 0%); }
}

/* Tool badges */
.tool-badge {
  display: inline-flex;
  align-items: center;
  background: rgba(255, 107, 129,0.1);
  border: 1px solid rgba(255, 107, 129,0.25);
  border-radius: 100px;
  padding: 5px 14px;
  font-size: 0.78rem;
  font-weight: 600;
  color: var(--primary-light);
  font-family: var(--font-code);
  transition: all var(--transition);
}
.tool-badge:hover {
  background: rgba(255, 107, 129,0.2);
  border-color: var(--primary);
  transform: translateY(-2px);
}

/* Soft skills */
.soft-card {
  background: var(--gradient-card);
  border: 1px solid var(--dark-border);
  border-radius: var(--radius-md);
  padding: 1.2rem 1rem;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  transition: all var(--transition);
  cursor: default;
}
.soft-card i {
  font-size: 1.6rem;
  background: var(--gradient-main);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
.soft-card span {
  font-size: 0.82rem;
  font-weight: 600;
  color: var(--text-muted);
}
.soft-card:hover {
  border-color: var(--primary);
  background: rgba(255, 107, 129,0.12);
  transform: translateY(-6px);
  box-shadow: var(--shadow-hover);
}
.soft-card:hover span { color: var(--text-primary); }

/* ======== 7. PROJETS ======== */
.project-card {
  background: var(--gradient-card);
  border: 1px solid var(--dark-border);
  border-radius: var(--radius-lg);
  padding: 1.5rem;
  height: 100%;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  transition: all var(--transition);
  position: relative;
  overflow: hidden;
}
.project-card::before {
  content: '';
  position: absolute;
  inset: 0;
  background: var(--gradient-main);
  opacity: 0;
  transition: opacity var(--transition);
  z-index: 0;
  border-radius: inherit;
}
.project-card:hover {
  transform: translateY(-10px);
  border-color: var(--primary);
  box-shadow: var(--shadow-hover);
}
.project-card:hover::before { opacity: 0.06; }
.project-card > * { position: relative; z-index: 1; }

.project-icon {
  width: 54px; height: 54px;
  border-radius: var(--radius-md);
  background: rgba(255, 107, 129,0.15);
  border: 1px solid rgba(255, 107, 129,0.3);
  display: flex; align-items: center; justify-content: center;
  font-size: 1.5rem;
  color: var(--primary-light);
  transition: all var(--transition);
  margin-bottom: 0.25rem;
}
.project-card:hover .project-icon {
  background: rgba(255, 107, 129,0.3);
  transform: scale(1.1) rotate(-5deg);
}

.project-tag {
  font-family: var(--font-code);
  font-size: 0.7rem;
  font-weight: 600;
  color: var(--secondary);
  background: rgba(208, 189, 244,0.1);
  border-radius: 100px;
  padding: 2px 10px;
  width: fit-content;
  border: 1px solid rgba(208, 189, 244,0.25);
}
.project-title {
  font-size: 1.15rem;
  font-weight: 700;
  color: var(--text-primary);
  margin: 0;
}
.project-desc {
  font-size: 0.88rem;
  color: var(--text-muted);
  flex: 1;
  line-height: 1.65;
  text-align: justify;
  -webkit-hyphens: auto;
  -ms-hyphens: auto;
  hyphens: auto;
}

.btn-project {
  display: inline-flex;
  align-items: center;
  color: var(--primary-light);
  font-size: 0.85rem;
  font-weight: 600;
  border-top: 1px solid var(--dark-border);
  padding-top: 0.75rem;
  margin-top: auto;
  transition: all var(--transition);
  width: fit-content;
}
.btn-project i { transition: transform var(--transition); }
.btn-project:hover { color: var(--primary); }
.btn-project:hover i { transform: translate(3px, -3px); }

.project-image {
  width: 100%;
  height: 160px;
  object-fit: cover;
  border-radius: var(--radius-md) var(--radius-md) 0 0;
  margin: -1.5rem -1.5rem 1rem -1.5rem;
  width: calc(100% + 3rem);
  border-bottom: 1px solid var(--dark-border);
  transition: all var(--transition);
}
.project-card:hover .project-image {
  opacity: 0.9;
}

/* ======== 8. TIMELINE ======== */
.timeline {
  position: relative;
  max-width: 900px;
  margin: 0 auto;
  padding: 1rem 0;
}
/* Ligne centrale */
.timeline::before {
  content: '';
  position: absolute;
  top: 0; bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 2px;
  background: linear-gradient(to bottom, var(--primary), var(--secondary));
  opacity: 0.4;
}

.timeline-item {
  width: 50%;
  padding: 0 3rem 3rem 0;
  position: relative;
}
.timeline-item--right {
  margin-left: 50%;
  padding: 0 0 3rem 3rem;
}

/* Point sur la ligne */
.timeline-dot {
  width: 18px; height: 18px;
  border-radius: 50%;
  background: var(--gradient-main);
  position: absolute;
  top: 16px;
  box-shadow: 0 0 0 4px rgba(255, 107, 129,0.25), var(--shadow-glow);
}
.timeline-item > .timeline-dot { right: -9px; }
.timeline-item--right > .timeline-dot { left: -9px; }

.timeline-year {
  font-family: var(--font-code);
  font-size: 0.78rem;
  font-weight: 700;
  color: var(--primary-light);
  background: rgba(255, 107, 129,0.12);
  border: 1px solid rgba(255, 107, 129,0.25);
  border-radius: 100px;
  padding: 3px 12px;
  display: inline-block;
  margin-bottom: 0.75rem;
}
.timeline-title {
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 4px;
}
.timeline-place {
  font-size: 0.82rem;
  color: var(--secondary);
  font-weight: 500;
  margin-bottom: 0.5rem;
}
.timeline-desc { font-size: 0.86rem; color: var(--text-muted); line-height: 1.6; }

.timeline-badge {
  display: inline-block;
  margin-top: 0.75rem;
  padding: 3px 12px;
  border-radius: 100px;
  font-size: 0.72rem;
  font-weight: 700;
  background: rgba(255, 107, 129,0.12);
  color: var(--primary-light);
  border: 1px solid rgba(255, 107, 129,0.25);
}
.timeline-badge.current {
  background: rgba(255, 228, 225, 0.12);
  color: var(--accent);
  border-color: rgba(255, 228, 225,0.3);
  animation: pulse 2s ease-in-out infinite;
}
@keyframes pulse {
  0%, 100% { box-shadow: 0 0 0 0 rgba(255, 228, 225,0.3); }
  50%         { box-shadow: 0 0 0 6px rgba(255, 228, 225,0); }
}

/* ======== 9. CONTACT ======== */
.contact-info-title {
  font-size: 1.3rem;
  font-weight: 700;
  margin-bottom: 0.75rem;
}
.contact-info-text { color: var(--text-muted); margin-bottom: 1.75rem; font-size: 0.9rem; }

.contact-detail-item {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin-bottom: 1.25rem;
}
.contact-detail-icon {
  width: 44px; height: 44px;
  border-radius: var(--radius-md);
  background: rgba(255, 107, 129,0.12);
  border: 1px solid rgba(255, 107, 129,0.25);
  display: flex; align-items: center; justify-content: center;
  font-size: 1.1rem;
  flex-shrink: 0;
  background: var(--gradient-main);
  color: #fff;
}
.contact-detail-label {
  display: block;
  font-size: 0.7rem;
  color: var(--text-muted);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  margin-bottom: 2px;
}
.contact-detail-value {
  color: var(--text-primary);
  font-size: 0.88rem;
  font-weight: 500;
  transition: color var(--transition);
  word-break: break-all;
}
a.contact-detail-value:hover { color: var(--primary-light); }

.social-icon-lg {
  width: 48px; height: 48px;
  border-radius: 50%;
  background: rgba(255, 107, 129,0.1);
  border: 1.5px solid rgba(255, 107, 129,0.25);
  display: flex; align-items: center; justify-content: center;
  font-size: 1.25rem;
  color: var(--primary-light);
  transition: all var(--transition);
}
.social-icon-lg:hover {
  background: var(--gradient-main);
  border-color: transparent;
  color: #fff;
  transform: translateY(-4px);
  box-shadow: var(--shadow-hover);
}

/* Formulaire */
.contact-form { padding: 2rem; }

.form-label-custom {
  display: block;
  font-size: 0.82rem;
  font-weight: 600;
  color: var(--text-muted);
  margin-bottom: 8px;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}
.form-control-custom {
  width: 100%;
  background: rgba(0, 0, 0, 0.03);
  border: 1.5px solid var(--dark-border);
  border-radius: var(--radius-md);
  padding: 0.75rem 1rem;
  color: var(--text-primary);
  font-family: var(--font-main);
  font-size: 0.9rem;
  transition: all var(--transition);
  outline: none;
  resize: vertical;
}
.form-control-custom::placeholder { color: rgba(160,160,192,0.5); }
.form-control-custom:focus {
  border-color: var(--primary);
  background: rgba(255, 107, 129,0.06);
  box-shadow: 0 0 0 3px rgba(255, 107, 129,0.15);
}

.form-feedback {
  margin-top: 1rem;
  padding: 0.875rem 1.25rem;
  border-radius: var(--radius-md);
  font-size: 0.88rem;
  font-weight: 500;
}
.form-feedback.success {
  background: rgba(255, 228, 225,0.1);
  border: 1px solid rgba(255, 228, 225,0.3);
  color: var(--accent);
}
.form-feedback.error {
  background: rgba(208, 189, 244,0.1);
  border: 1px solid rgba(208, 189, 244,0.3);
  color: var(--secondary);
}

/* ======== 10. FOOTER ======== */
.site-footer {
  background: var(--dark-card);
  border-top: 1px solid var(--dark-border);
  padding: 2rem 0;
}
.footer-brand {
  font-family: var(--font-code);
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--text-primary);
}
.footer-brand:hover { color: var(--primary-light); }
.footer-tagline {
  font-size: 0.82rem;
  color: var(--text-muted);
  margin-bottom: 4px;
  font-style: italic;
}
.footer-copy { font-size: 0.8rem; color: var(--text-muted); margin: 0; }

.footer-social-link {
  width: 38px; height: 38px;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  background: rgba(255, 107, 129,0.08);
  border: 1px solid var(--dark-border);
  color: var(--text-muted);
  font-size: 1rem;
  transition: all var(--transition);
}
.footer-social-link:hover {
  color: var(--primary-light);
  border-color: var(--primary);
  background: rgba(255, 107, 129,0.15);
  transform: translateY(-3px);
}

/* ======== 11. BACK TO TOP ======== */
.back-to-top {
  position: fixed;
  bottom: 30px;
  right: 30px;
  width: 46px; height: 46px;
  border-radius: 50%;
  background: var(--gradient-main);
  color: #fff;
  text-decoration: none;
  display: flex; align-items: center; justify-content: center;
  font-size: 1.1rem;
  opacity: 1;
  visibility: visible;
  transition: all var(--transition);
  box-shadow: 0 4px 20px rgba(255, 107, 129,0.5);
  z-index: 999;
}
.back-to-top:hover {
  transform: translateY(-4px);
  box-shadow: 0 8px 30px rgba(255, 107, 129,0.7);
  color: #fff;
}

/* ======== 12. Animations CSS pures (sans JavaScript) ======== */
[data-aos="fade-up"]    { animation: fadeInUp    0.7s ease both; }
[data-aos="fade-right"] { animation: fadeInRight 0.7s ease both; }
[data-aos="fade-left"]  { animation: fadeInLeft  0.7s ease both; }
[data-aos="zoom-in"]    { animation: zoomIn      0.6s ease both; }

/* Délais */
[data-aos-delay="80"]  { animation-delay: 0.08s; }
[data-aos-delay="100"] { animation-delay: 0.10s; }
[data-aos-delay="150"] { animation-delay: 0.15s; }
[data-aos-delay="160"] { animation-delay: 0.16s; }
[data-aos-delay="240"] { animation-delay: 0.24s; }
[data-aos-delay="300"] { animation-delay: 0.30s; }
[data-aos-delay="320"] { animation-delay: 0.32s; }
[data-aos-delay="400"] { animation-delay: 0.40s; }
[data-aos-delay="480"] { animation-delay: 0.48s; }

@keyframes fadeInUp    { from { opacity:0; transform:translateY(40px); } to { opacity:1; transform:none; } }
@keyframes fadeInRight { from { opacity:0; transform:translateX(-40px); } to { opacity:1; transform:none; } }
@keyframes fadeInLeft  { from { opacity:0; transform:translateX(40px); } to { opacity:1; transform:none; } }
@keyframes zoomIn      { from { opacity:0; transform:scale(0.85); } to { opacity:1; transform:none; } }

/* ======== 13. RESPONSIVE ======== */
@media (max-width: 991px) {
  .timeline::before { left: 20px; }
  .timeline-item, .timeline-item--right {
    width: 100%;
    margin-left: 0;
    padding: 0 0 2.5rem 3.5rem;
  }
  .timeline-item > .timeline-dot,
  .timeline-item--right > .timeline-dot { left: 11px; right: auto; }
}

@media (max-width: 767px) {
  .section-padding { padding: 70px 0; }
  .hero-section { padding-top: 80px; }
  .hero-name { font-size: clamp(2.5rem, 12vw, 4rem); }
  .float-badge { display: none; }
  .glass-card { padding: 1.5rem 1.25rem; }
  .contact-form { padding: 1.5rem 1.25rem; }
  .back-to-top { bottom: 20px; right: 20px; }

  /* Mobile navbar */
  #navMenu {
    background: var(--dark-card);
    margin-top: 0.5rem;
    border-radius: var(--radius-md);
    padding: 1rem;
    border: 1px solid var(--dark-border);
  }

  .navbar-nav .nav-link { padding: 0.6rem 0.5rem !important; }
}

@media (max-width: 480px) {
  .hero-actions { justify-content: center; }
  .hero-socials { justify-content: center; }
  .hero-text { text-align: center; }
  .hero-desc { margin: 0 auto; }
}


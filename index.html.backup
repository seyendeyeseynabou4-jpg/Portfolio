        <div class="col-md-4 text-center text-md-end">
          <div class="footer-socials d-flex justify-content-center justify-content-md-end gap-3">
            <a href="https://github.com/repos" target="_blank" class="footer-social-link" title="GitHub">
              <i class="bi bi-github"></i>
            </a>
            <a href="mailto:seyendeyeseynabou4@gmail.com" class="footer-social-link" title="Email">
              <i class="bi bi-envelope-fill"></i>
            </a>
          </div>
        </div>
      </div>
    </div>
  </footer>

  <!-- Back to top -->
  <a href="#hero" class="back-to-top" aria-label="Retour en haut" title="Retour en haut">
    <i class="bi bi-chevron-up"></i>
  </a>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <!-- JS : Bootstrap uniquement (navbar hamburger + scrollspy) -->
  <script>
    // Initialisation Bootstrap ScrollSpy
    new bootstrap.ScrollSpy(document.body, { target: '#mainNav', offset: 90 });

    // Souligner le lien cliqué immédiatement
    document.querySelectorAll('.nav-link').forEach(link => {
      link.addEventListener('click', function () {
        document.querySelectorAll('.nav-link').forEach(l => l.classList.remove('active'));
        this.classList.add('active');
      });
    });
  </script>
</body>

</html>
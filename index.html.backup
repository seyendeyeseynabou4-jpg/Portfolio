  <!-- ======================================
       SECTION PROJETS
  ====================================== -->
  <section id="projects" class="section-padding">
    <div class="container">
      <div class="section-header text-center mb-5" data-aos="fade-up">
        <span class="section-tag">Ce que j'ai construit</span>
        <h2 class="section-title">Mes <span class="gradient-text">Projets</span></h2>
      </div>

      <div class="row g-4 justify-content-center">

        <!-- Projet 1 : Bibliothèque -->
        <div class="col-md-6 col-lg-5" data-aos="fade-up" data-aos-delay="0">
          <div class="project-card">
            <img src="assets/bibliotheque.png" alt="Image de la Bibliothèque" class="project-image" />
            <span class="project-tag"> C++</span>
            <h4 class="project-title">Bibliothèque numèrique</h4>
            <p class="project-desc text-justify">
              Application en ligne de commande développée en C++ permettant de gérer une bibliothèque de livres.
              Elle permet de consulter, ajouter, rechercher et supprimer des références, ainsi que d’importer des livres depuis un fichier CSV et d’exporter la bibliothèque en HTML.
              L’application propose une navigation claire avec des menus, un affichage paginé et une gestion des données via des fichiers.
            </p>
          </div>
        </div>

        <!-- Projet 2 : Calculatrice -->
        <div class="col-md-6 col-lg-5" data-aos="fade-up" data-aos-delay="100">
          <div class="project-card">
            <img src="assets/calculatrice.png" alt="Image de la Calculatrice" class="project-image" />
            <span class="project-tag">C++</span>
            <h4 class="project-title">Calculatrice à polynômes</h4>
            <p class="project-desc text-justify">
              Calculatrice développée en C++ permettant de créer et manipuler des polynômes.
              Elle permet d’effectuer des opérations comme l’addition, la dérivation, la comparaison, ainsi que le calcul de la valeur d’un polynôme pour une valeur donnée.
              Le projet utilise la programmation orientée objet et la surcharge d’opérateurs pour rendre l’utilisation simple et proche de l’écriture mathématique.
            </p>

          </div>
        </div>

        <!-- Projet 3 : Site IUT -->
        <div class="col-md-6 col-lg-5" data-aos="fade-up" data-aos-delay="200">
          <div class="project-card">
            <img src="assets/site_iut.png" alt="Image du Site IUT" class="project-image" />
            <span class="project-tag">HTML / CSS</span>
            <h4 class="project-title">Site web IUT</h4>
            <p class="project-desc text-justify">
              Site web développé en HTML/CSS visant à présenter le <strong>BUT</strong> Informatique de l’IUT d’Aix-Marseille à des lycéens.
              Il permet de découvrir la formation, les compétences acquises, le parcours proposé à Arles, les débouchés professionnels ainsi que l’organisation des cours et des SAÉ.
              Le site propose une navigation claire avec différentes sections et respecte la charte graphique de l’IUT.
            </p>

          </div>
        </div>

        <!-- Projet 4 : Comparaison algo -->
        <div class="col-md-6 col-lg-5" data-aos="fade-up" data-aos-delay="300">
          <div class="project-card">
            <img src="assets/comparaison_algos.png" alt="Image de comparaison d'algorithmes" class="project-image" />
            <span class="project-tag">Python / C++</span>
            <h4 class="project-title">Comparaison d'algos</h4>
            <p class="project-desc text-justify">
              Projet réalisé en C++ visant à comparer les performances de différents algorithmes de tri.
              Il consiste à tester plusieurs méthodes (comme quicksort, insertion sort ou selection sort) sur différents types de données et tailles de tableaux, puis à analyser leur temps d’exécution.
              Les résultats sont ensuite représentés sous forme de graphiques afin de mieux visualiser les différences de performance.
            </p>

          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ======================================
       SECTION PARCOURS (TIMELINE)
  ====================================== -->
  <section id="timeline" class="section-padding section-dark">
    <div class="container">
      <div class="section-header text-center mb-5" data-aos="fade-up">
        <span class="section-tag">Mon chemin</span>
        <h2 class="section-title">Mon <span class="gradient-text">Parcours</span></h2>
      </div>

      <div class="timeline">

        <!-- Entrée 1 -->
        <div class="timeline-item" data-aos="fade-right" data-aos-delay="0">
          <div class="timeline-dot"></div>
          <div class="timeline-card glass-card">
            <span class="timeline-year">2025 – 2026</span>
            <h4 class="timeline-title">BUT Informatique</h4>
            <p class="timeline-place"><i class="bi bi-geo-alt-fill me-1"></i>IUT Aix-Marseille · Arles</p>
            <p class="timeline-desc">
              Formation universitaire technologique en informatique : programmation, bases de données, réseaux,
              développement logiciel.
            </p>
            <span class="timeline-badge current">En cours</span>
          </div>
        </div>

        <!-- Entrée 2 -->
        <div class="timeline-item timeline-item--right" data-aos="fade-left" data-aos-delay="150">
          <div class="timeline-dot"></div>
          <div class="timeline-card glass-card">
            <span class="timeline-year">2024 – 2025</span>
            <h4 class="timeline-title">Informatique – Licence</h4>
            <p class="timeline-place"><i class="bi bi-geo-alt-fill me-1"></i>Université Cheikh Ahmadoul Khadim · Sénégal
            </p>
            <p class="timeline-desc">
              Première expérience universitaire en informatique : algorithmique, programmation C et introduction aux
              systèmes.
            </p>
          </div>
        </div>

        <!-- Entrée 3 -->
        <div class="timeline-item" data-aos="fade-right" data-aos-delay="300">
          <div class="timeline-dot"></div>
          <div class="timeline-card glass-card">
            <span class="timeline-year">2024</span>
            <h4 class="timeline-title">Baccalauréat S2</h4>
            <p class="timeline-place"><i class="bi bi-geo-alt-fill me-1"></i>Sciences Expérimentales · Sénégal</p>
            <p class="timeline-desc">
              Obtention du Bac série S2 (Sciences expérimentales), avec une orientation marquée vers les matières
              scientifiques.
            </p>
            <span class="timeline-badge">Diplômée</span>
          </div>
        </div>

      </div>
    </div>
  </section>

